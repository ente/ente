# Local env files
.env
.env.*.local

# tsc transpiles src/**/*.ts and emits the generated JS into app
app/

# out is a symlink to the photos web app's out dir, which contains the built up
# photos app.
out

# electron-builder
dist/

# We download it on demand, if needed for the particular OS/arch.
build/vips*

# Staged by scripts/ort.js for the particular OS/arch.
build/onnxruntime/

# Rust N-API addons staged for packaging by scripts/napi.js.
build/napi/

# The Rust ML addon built by scripts/napi.js, and the declarations generated by
# `cargo codegen napi`.
rust-bindings/
