{
    "compilerOptions": {
        /* Match Electron's embedded Node.js runtime. */
        "lib": [
            "ES2024",
            "ESNext.Array",
            "ESNext.Collection",
            "ESNext.Error",
            "ESNext.Iterator",
            "ESNext.Promise"
        ],
        "module": "nodenext",
        "target": "ES2024",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "types": ["node"],

        "rootDir": "src",
        "outDir": "app",

        "strict": true,
        "noImplicitReturns": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true
    },
    "include": ["src"]
}
