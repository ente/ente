# Copy to .env beside config/compose.yaml.

# These must match db.user, db.password, and db.name in museum.yaml.
POSTGRES_USER=pguser
POSTGRES_PASSWORD=<password>
POSTGRES_DB=ente_db

# These must match the key and secret of each MinIO-backed s3 bucket in museum.yaml.
# Omit them when using external buckets instead of the bundled MinIO service.
MINIO_ROOT_USER=-
MINIO_ROOT_PASSWORD=<secret>

# Museum endpoint used by the web apps.
ENTE_API_ORIGIN=http://localhost:8080
